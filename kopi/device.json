{
  "title": "Kopi",
  "config": {
    "file": "/.crosspoint/kopi.json"
  },
  "browse": {
    "format": "json",
    "url": "{cfg.url}/opds/list?page={page}&limit={limit}",
    "method": "GET",
    "headers": {
      "Authorization": "Basic {cfg.auth}",
      "Accept": "application/json"
    },
    "items": "items",
    "fields": {
      "title": "title",
      "url": "url",
      "id": "id"
    },
    "page_size": 16
  },
  "download": {
    "url": "{url}",
    "username": "{cfg.user}",
    "password": "{cfg.pass}",
    "dest_dir": "/Kopi",
    "filename": "{title}.epub"
  },
  "description": "Browse and download your Kopi briefings.",
  "author": "ruqqq",
  "version": "1.2.0"
}
